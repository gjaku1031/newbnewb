{
  "name": "newb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "annotations": "agentation-mcp server --port 4747",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/migrate.cjs --log-level=warning && node --env-file-if-exists=.env.local dist/migrate.cjs",
    "db:studio": "drizzle-kit studio",
    "auth:invite": "esbuild scripts/passkey-invite.ts --bundle --platform=node --format=cjs --packages=external --alias:server-only=./scripts/server-only-stub.mjs --outfile=dist/passkey-invite.cjs --log-level=warning && node --env-file-if-exists=.env.local dist/passkey-invite.cjs",
    "test": "vitest run",
    "postinstall": "patch-package",
    "test:e2e": "playwright test",
    "test:seed": "esbuild test/fixtures/seed-cli.ts --bundle --platform=node --format=cjs --packages=external --alias:server-only=./scripts/server-only-stub.mjs --outfile=dist/test-seed.cjs --log-level=warning && node --env-file-if-exists=.env.local dist/test-seed.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1160.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "agentation": "3.1.2",
    "cfb": "^1.2.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.65.0",
    "mysql2": "^3.24.6",
    "next": "16.4.3",
    "oci-common": "^2.143.0",
    "oci-objectstorage": "^2.143.0",
    "pretendard": "^1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testcontainers/mysql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation-mcp": "^1.3.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
