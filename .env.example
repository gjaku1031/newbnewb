# 다른 기기에서 개발 서버에 접속할 때 허용할 주소 (쉼표로 구분)
DEV_ORIGINS=

# Agentation 주석 서버 주소 (기본: http://localhost:4747)
AGENTATION_URL=

# ── DB (MySQL) ──────────────────────────────
# 로컬: docker compose up -d 로 뜬 MySQL (compose.yaml 기본값)
DATABASE_URL=mysql://newb:newb_dev@127.0.0.1:23306/newb
# 운영: TLS 검증용 CA 파일 경로 (지정하면 TLS 필수)
DATABASE_SSL_CA_FILE=

# ── Object Storage (S3 호환) ─────────────────
# 로컬: RustFS (콘솔 http://127.0.0.1:19001)
# 운영: https://<namespace>.compat.objectstorage.ap-tokyo-1.oraclecloud.com
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=ap-tokyo-1
S3_BUCKET=newb-dev
# 운영: OCI 사용자 → 고객 비밀 키(Customer Secret Key)
S3_ACCESS_KEY_ID=newb_dev
S3_SECRET_ACCESS_KEY=newb_dev_secret
