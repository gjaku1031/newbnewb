# ── 로그인 (Passkey) ─────────────────────────
# 이 앱의 주소 — Passkey는 이 주소(도메인)에 묶인다. 운영: https://newb.maekr.cloud (compose.yaml)
APP_ORIGIN=http://localhost:3000
# next dev는 기본으로 로그인된 상태. off면 실제 Passkey 로그인 (localhost에서만 동작, 초대: npm run auth:invite)
NEWB_DEV_LOGIN=

# 다른 기기에서 개발 서버에 접속할 때 허용할 주소 (쉼표로 구분)
DEV_ORIGINS=

# Agentation 주석 서버 주소 (기본: http://localhost:4747)
AGENTATION_URL=

# ── DB (MySQL) ──────────────────────────────
# 로컬: docker compose up -d 로 뜬 MySQL (compose.yaml 기본값)
# 운영: oci-prod:/srv/newb/newb.env 의 DATABASE_URL (…?ssl=true → TLS 암호화)
DATABASE_URL=mysql://newb:newb_dev@127.0.0.1:23306/newb
# (선택) off | required | verify_ca — 생략하면 CA 파일이 있으면 verify_ca, 주소에 ssl=true면 required
DATABASE_SSL=
# (선택) ken-prod 인증서(BYOC)를 검증할 사설 CA(PEM) 경로
DATABASE_SSL_CA_FILE=

# ── Object Storage ───────────────────────────
# 운영: oci-prod:/srv/newb/object-storage.env (OCI SDK + 서버 인증, 비밀키 없음)
#   OCI_AUTH=instance_principal  OCI_REGION=ap-tokyo-1  OCI_NAMESPACE=…  OCI_BUCKET=newb-files
#   oci-dev에서 확인할 때는 OCI_AUTH=config_file (~/.oci/config, OCI_CONFIG_FILE·OCI_PROFILE로 바꿀 수 있음)
# OCI_AUTH가 비어 있으면 아래 S3 호환 설정을 쓴다 (로컬 RustFS, 콘솔 http://127.0.0.1:19001)
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=ap-tokyo-1
S3_BUCKET=newb-dev
S3_ACCESS_KEY_ID=newb_dev
S3_SECRET_ACCESS_KEY=newb_dev_secret

# ── Claude API ───────────────────────────────
# 메모 정리·위키 주석 반영·위키 모순 검토. 비어 있으면 이 기능들이 동작하지 않음 (테스트는 가짜 Claude 서버)
# 운영: oci-prod:/srv/newb/anthropic.env
ANTHROPIC_API_KEY=
# (선택) 기본 claude-opus-5-5
CLAUDE_MODEL=
